---
import { Linkedin, Mail, Menu, X } from 'lucide-astro';

interface Props {
	contactHref?: string;
}

const { contactHref = '/#contact-form' } = Astro.props;
---

<details class="mobile-nav">
	<summary aria-label="Open navigation">
		<span class="menu-icon" aria-hidden="true"><Menu size={20} /></span>
		<span class="close-icon" aria-hidden="true"><X size={20} /></span>
	</summary>
	<div class="mobile-nav-panel">
		<nav aria-label="Mobile navigation">
			<a href="/work">Work</a>
			<a href="/blog">Random Thoughts</a>
			<a href="/about">About</a>
			<a class="contact-link" href={contactHref}>Let’s talk</a>
		</nav>
		<div class="mobile-socials" aria-label="Contact links">
			<a href="https://linkedin.com" aria-label="LinkedIn"><Linkedin size={18} /></a>
			<a href="mailto:brian@brianmonroe.io" aria-label="Email Brian Monroe"><Mail size={18} /></a>
		</div>
	</div>
</details>

<style>
	.mobile-nav { position: relative; display: none; margin-left: auto; }
	summary { display: grid; width: 40px; height: 40px; place-items: center; border: 1px solid rgba(255,255,255,.14); border-radius: 50%; background: rgba(255,255,255,.07); color: #eef0ec; cursor: pointer; list-style: none; }
	summary::-webkit-details-marker { display: none; }
	summary:hover { border-color: rgba(232,115,56,.5); background: rgba(232,115,56,.1); }
	.close-icon { display: none; }
	details[open] .menu-icon { display: none; }
	details[open] .close-icon { display: inline-flex; }
	.mobile-nav-panel { position: absolute; z-index: 30; top: calc(100% + 12px); right: 0; width: min(310px, calc(100vw - 28px)); padding: 10px; border: 1px solid rgba(255,255,255,.13); border-radius: 16px; background: rgba(13,16,14,.98); box-shadow: 0 24px 60px rgba(0,0,0,.42), inset 0 1px rgba(255,255,255,.06); backdrop-filter: blur(20px); }
	nav { display: grid; }
	nav a { padding: 13px 14px; border-radius: 9px; color: #d9ddd7; font-size: 17px; font-weight: 600; }
	nav a:hover, nav a:focus-visible { background: rgba(255,255,255,.065); color: #fff; }
	nav .contact-link { margin-top: 5px; background: rgba(232,115,56,.13); color: #f19a6f; }
	.mobile-socials { display: flex; gap: 9px; margin-top: 10px; padding: 12px 14px 4px; border-top: 1px solid rgba(255,255,255,.1); }
	.mobile-socials a { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; color: #b9beb7; }
	.mobile-socials a:hover, .mobile-socials a:focus-visible { border-color: rgba(232,115,56,.48); color: #fff; }
	@media (max-width: 700px) {
		.mobile-nav { display: block; }
	}
</style>
