---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const {
  eyebrow,
  title,
  description
} = Astro.props;
---

<section class="border-b border-neutral-200 bg-[#fafaf8]">
  <div class="mx-auto max-w-7xl px-6 py-24">

    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-700">
        {eyebrow}
      </p>
    )}

    <h1 class="mt-4 max-w-4xl text-5xl font-bold leading-tight md:text-6xl">
      {title}
    </h1>

    <p class="mt-8 max-w-3xl text-lg leading-8 text-neutral-600">
      {description}
    </p>

  </div>
  
</section>