---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const {
  eyebrow,
  title,
  description
} = Astro.props;
---

<section class="page-hero">
  <div class="site-shell">
    {eyebrow && <p class="page-eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>
