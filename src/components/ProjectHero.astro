---
const { project } = Astro.props;

const {
    title,
    client,
    featuredImage,
    excerpt,
    categories,
    website
} = project.data;
---

<section class="bg-[#fafaf8] border-b border-neutral-200">

    <div class="mx-auto max-w-7xl px-6 py-20">

        <div class="grid gap-16 items-center lg:grid-cols-2">

            <div>

                <div class="flex flex-wrap gap-2">

                    {
                        categories.map(category => (

                            <span
                                class="rounded-full bg-orange-100 px-3 py-1 text-xs font-medium text-orange-700"
                            >
                                {category}
                            </span>

                        ))
                    }

                </div>

                <h1 class="mt-6 text-5xl font-bold">
                    {title}
                </h1>

                <p class="mt-4 text-xl text-neutral-500">
                    {client}
                </p>

                <p class="mt-8 max-w-xl text-lg text-neutral-600">
                    {excerpt}
                </p>

                {
                    website && (

                        <a
                            href={website}
                            target="_blank"
                            class="mt-10 inline-flex rounded bg-orange-700 px-6 py-3 text-white hover:bg-orange-800"
                        >
                            Visit Website
                        </a>

                    )
                }

            </div>

            <div>

                <img
                    src={featuredImage}
                    alt={title}
                    class="rounded-2xl shadow-xl"
                />

            </div>

        </div>

    </div>

</section>