---
import {
  Facebook,
  Instagram,
  Linkedin,
  Github,
  Mail
} from "lucide-astro";
---

<footer class="bg-neutral-950 border-t border-orange-700/30 bg-neutral-950 text-white">
  <div class="mx-auto max-w-7xl px-6 py-20">

    <div class="grid gap-12 lg:grid-cols-3">

      <!-- Brand -->

      <div>
        <img
          src="/logo/brianmonroeio.webp"
          alt="Brian Monroe"
          class="h-12 w-auto"
        />

        <p class="mt-5 max-w-sm text-neutral-400 leading-relaxed">
          Helping businesses, organizations, and events build a stronger
          online presence through web development, SEO, photography,
          and digital marketing.
        </p>

        <p class="mt-4 text-sm text-neutral-500">
          Based in Celina, Ohio
        </p>
      </div>

      <!-- Navigation -->

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">
          Navigation
        </h3>

        <ul class="mt-4 space-y-3 text-neutral-300">
          <li>
            <a href="/work" class="transition hover:text-orange-500">
              Work
            </a>
          </li>

          <li>
            <a href="/services" class="transition hover:text-orange-500">
              Services
            </a>
          </li>

          <li>
            <a href="/blog" class="transition hover:text-orange-500">
              Blog
            </a>
          </li>

          <li>
            <a href="/free-audit" class="transition hover:text-orange-500">
              Free Audit
            </a>
          </li>

          <li>
            <a href="/contact" class="transition hover:text-orange-500">
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Connect -->

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">
          Connect
        </h3>

        <div class="mt-5 flex items-center gap-5">

          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-neutral-400 transition hover:text-orange-500"
          >
            <Linkedin size={22} />
          </a>

          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="text-neutral-400 transition hover:text-orange-500"
          >
            <Facebook size={22} />
          </a>

          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="text-neutral-400 transition hover:text-orange-500"
          >
            <Instagram size={22} />
          </a>

          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-neutral-400 transition hover:text-orange-500"
          >
            <Github size={22} />
          </a>

          <a
            href="mailto:brian@brianmonroe.io"
            aria-label="Email"
            class="text-neutral-400 transition hover:text-orange-500"
          >
            <Mail size={22} />
          </a>

        </div>

        <p class="mt-5 text-sm text-neutral-500">
          Follow my latest projects, photography,
          and web development work.
        </p>
      </div>

    </div>

    <!-- Bottom Bar -->

    <div class="mt-16 border-t border-neutral-800 pt-8">

      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

        <p class="text-sm text-neutral-500">
          © {new Date().getFullYear()} Brian Monroe. All rights reserved.
        </p>

        <div class="flex gap-6 text-sm">

          <a
            href="/privacy-policy"
            class="text-neutral-500 transition hover:text-orange-500"
          >
            Privacy Policy
          </a>

          <a
            href="/terms-of-service"
            class="text-neutral-500 transition hover:text-orange-500"
          >
            Terms of Service
          </a>

        </div>

      </div>

    </div>

  </div>
</footer>