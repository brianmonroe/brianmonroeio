---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={title} description={description} /></head>
	<body class="site-page">
		<Header />
		<main>
			<article>
				<header class="article-header site-shell">
					<p class="page-eyebrow">Random thoughts</p>
					<h1>{title}</h1>
					<p class="article-description">{description}</p>
					<p class="article-date">
						<FormattedDate date={pubDate} />
						{updatedDate && <> · Updated <FormattedDate date={updatedDate} /></>}
					</p>
				</header>
				{heroImage && <div class="article-image site-shell"><Image width={1040} height={520} src={heroImage} alt="" /></div>}
				<div class="content-section"><div class="prose-dark site-shell"><slot /></div></div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-header { padding: 100px 0 50px; text-align: left; }
	.article-header h1 { max-width: 850px; margin: 0; font-size: clamp(2.8rem, 7vw, 5rem); font-weight: 500; line-height: 1.03; letter-spacing: -.05em; }
	.article-description { max-width: 700px; margin: 22px 0 0; color: #a4aaa2; font-size: 20px; }
	.article-date { margin: 24px 0 0; color: #747a73; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
	.article-image img { display: block; width: 100%; max-height: 510px; object-fit: cover; border: 1px solid rgba(255,255,255,.1); border-radius: 20px; filter: saturate(.72); }
	@media(max-width: 700px) { .article-header { padding: 72px 0 42px; } .article-description { font-size: 17px; } }
</style>
