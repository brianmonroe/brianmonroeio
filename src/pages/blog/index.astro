---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ArrowUpRight } from 'lucide-astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head><BaseHead title="Random Thoughts | Brian Monroe" description="Notes on websites, design, photography, and whatever else is on my mind." /></head>
	<body class="site-page">
		<Header />
		<main>
			<section class="page-hero">
				<div class="site-shell">
					<p class="page-eyebrow">Notes & observations</p>
					<h1>Random Thoughts</h1>
					<p>Occasional notes about building for the web, creative work, useful tools, and whatever else feels worth writing down.</p>
				</div>
			</section>
			<section class="content-section">
				<div class="site-shell post-list">
					{posts.map((post, index) => (
						<a class="glass-panel post-card" href={`/blog/${post.id}/`}>
							{post.data.heroImage && <Image width={280} height={180} src={post.data.heroImage} alt="" />}
							<div class="post-copy">
								<p class="post-meta"><FormattedDate date={post.data.pubDate} /> · Note {String(index + 1).padStart(2, '0')}</p>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
							</div>
							<span class="post-arrow"><ArrowUpRight size={18} /></span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-list { display: grid; gap: 14px; }
	.post-card { display: grid; grid-template-columns: 180px 1fr 44px; align-items: center; gap: 28px; padding: 20px; transition: transform .2s, border-color .2s; }
	.post-card:hover { transform: translateY(-2px); border-color: rgba(232,115,56,.38); }
	.post-card img { width: 180px; height: 120px; object-fit: cover; border-radius: 12px; filter: saturate(.72); }
	.post-meta { margin: 0 0 8px !important; color: #777d76 !important; font-size: 12px !important; letter-spacing: .08em; text-transform: uppercase; }
	.post-copy h2 { margin: 0; color: #eef0ec; font-size: 27px; font-weight: 500; letter-spacing: -.025em; }
	.post-copy > p:last-child { margin: 7px 0 0; color: #a4aaa2; font-size: 16px; }
	.post-arrow { display: grid; width: 40px; height: 40px; place-items: center; border: 1px solid rgba(255,255,255,.11); border-radius: 50%; color: #c9cdc7; }
	@media (max-width: 680px) {
		.post-card { grid-template-columns: 1fr 40px; gap: 18px; }
		.post-card img { grid-column: 1 / -1; width: 100%; height: 190px; }
	}
</style>
