---
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight, ChevronLeft, ChevronRight, Maximize2, X } from 'lucide-astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);

const categoryLabels: Record<string, string> = {
	Website: 'Web',
	Web: 'Web',
	Photography: 'Photography',
	Photo: 'Photography',
	SEO: 'Miscellaneous',
	Social: 'Miscellaneous',
	'Social Media': 'Miscellaneous',
	Print: 'Miscellaneous',
};

const classify = (category: string) => categoryLabels[category] ?? 'Miscellaneous';
const projectTypes = ['Web', 'Photography', 'Miscellaneous'];
---

<!doctype html>
<html lang="en">
	<head><BaseHead title="Work | Brian Monroe" description="Web, photography, social media, print, and marketing work by Brian Monroe." /></head>
	<body class="site-page work-page">
		<Header />
		<main>
			<PageHero eyebrow="Project archive" title="Work, over time." description="A chronological feed of websites, photography, campaigns, print pieces, and the systems that connect them." />

			<section class="work-feed-section" aria-labelledby="work-feed-heading">
				<div class="site-shell">
					<div class="feed-controls">
						<h2 id="work-feed-heading">Project feed</h2>
						<div class="filter-group">
							<p class="feed-label">Browse by type</p>
							<div class="work-filters" aria-label="Filter projects">
								<button class="is-active" type="button" data-filter="all" aria-pressed="true">All work</button>
								{projectTypes.map((type) => <button type="button" data-filter={type} aria-pressed="false">{type}</button>)}
							</div>
						</div>
					</div>

					<div class="timeline">
						{projects.map((project) => {
							const types = [...new Set(project.data.categories.map(classify))];
							const isPhotography = project.data.categories.includes('Photography');
							return (
								<article class="timeline-entry" data-types={types.join('|')}>
									<div class="timeline-date"><span>{project.data.year}</span></div>
									<div class="timeline-marker" aria-hidden="true"><span></span></div>
									<div class="glass-panel feed-card">
										{isPhotography && project.data.gallery.length > 0 ? (
											<div class="photo-mosaic">
												{project.data.gallery.slice(0, 3).map((image, index) => (
													<button type="button" class="work-photo-open" data-gallery={project.id} data-photo-index={index} aria-label={`Enlarge ${project.data.title} photo ${index + 1}`}>
														<img src={image} alt={`${project.data.title}, photo ${index + 1}`} loading="lazy" />
														<span aria-hidden="true"><Maximize2 size={14} /></span>
													</button>
												))}
												<div hidden>{project.data.gallery.slice(3).map((image, index) => <img class="gallery-source" data-gallery={project.id} src={image} alt={`${project.data.title}, photo ${index + 4}`} loading="lazy" />)}</div>
											</div>
										) : (
							<a class:list={["feed-image", { "scroll-preview": project.data.previewImage }]} href={`/work/${project.id}`} aria-label={`View ${project.data.title}`}>
								<img src={project.data.previewImage ?? project.data.featuredImage} alt="" loading="lazy" onerror="this.remove()" />
								{project.data.previewImage && <span class="feed-preview-hint">Hover to preview</span>}
							</a>
										)}
										<div class="feed-copy">
											<div class="feed-types">{types.map((type) => <span>{type}</span>)}</div>
											<p class="feed-client">{project.data.client}</p>
											<h3>{project.data.title}</h3>
											<p class="feed-excerpt">{project.data.excerpt}</p>
											<div class="feed-actions">
												<a href={`/work/${project.id}`}>Project details <ArrowRight size={14} aria-hidden="true" /></a>
												{isPhotography && project.data.gallery.length > 0 && <button class="view-gallery" type="button" data-gallery={project.id}>View gallery <Maximize2 size={14} aria-hidden="true" /></button>}
												{project.data.website && <a href={project.data.website} target="_blank" rel="noopener noreferrer">Visit website <ArrowUpRight size={14} aria-hidden="true" /></a>}
											</div>
										</div>
									</div>
								</article>
							);
						})}
					</div>
					<p class="empty-feed" hidden>No projects match that category yet.</p>
				</div>
			</section>

			<dialog class="work-photo-lightbox" aria-label="Selected photography viewer">
				<div class="work-lightbox-frame">
					<button class="work-lightbox-close" type="button" aria-label="Close viewer"><X size={22} /></button>
					<button class="work-lightbox-nav work-lightbox-prev" type="button" aria-label="Previous photo"><ChevronLeft size={28} /></button>
					<div class="work-lightbox-content">
						<img class="work-lightbox-image" src="" alt="" />
						<div class="work-lightbox-meta"><p class="work-lightbox-caption"></p><p class="work-lightbox-count" aria-live="polite"></p></div>
					</div>
					<button class="work-lightbox-nav work-lightbox-next" type="button" aria-label="Next photo"><ChevronRight size={28} /></button>
				</div>
			</dialog>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(.work-page .page-hero) { padding-top: 64px; padding-bottom: 48px; }
	:global(.work-page .page-hero h1) { font-size: clamp(2.5rem, 5vw, 3.8rem); }
	:global(.work-page .page-hero > .site-shell > p:last-child) { margin-top: 16px; }
	.work-feed-section { padding: 70px 0 110px; }
	.feed-controls { display: flex; align-items: end; justify-content: space-between; gap: 36px; margin-bottom: 54px; }
	.feed-label { margin: 0 0 10px; color: #d88960; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
	.feed-controls h2 { margin: 0; color: #eef0ec; font-size: 34px; font-weight: 500; letter-spacing: -.03em; }
	.filter-group { display: grid; justify-items: end; }
	.work-filters { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
	.work-filters button { padding: 8px 13px; border: 1px solid rgba(255,255,255,.1); border-radius: 999px; background: rgba(255,255,255,.025); color: #929890; font: 700 11px/1 Atkinson, sans-serif; letter-spacing: .06em; cursor: pointer; transition: color .2s, border-color .2s, background .2s; }
	.work-filters button:hover, .work-filters button.is-active { border-color: rgba(232,115,56,.48); background: rgba(232,115,56,.1); color: #f0a079; }
	.timeline { position: relative; }
	.timeline::before { content: ""; position: absolute; top: 10px; bottom: 10px; left: 91px; width: 1px; background: linear-gradient(rgba(232,115,56,.5), rgba(255,255,255,.09) 18%, rgba(255,255,255,.09) 85%, transparent); }
	.timeline-entry { display: grid; grid-template-columns: 70px 43px minmax(0, 1fr); align-items: start; margin-bottom: 24px; }
	.timeline-entry[hidden] { display: none; }
	.timeline-date { padding-top: 28px; color: #8b918a; font: 12px/1 ui-monospace, monospace; letter-spacing: .08em; }
	.timeline-marker { position: relative; display: grid; padding-top: 30px; place-items: start center; }
	.timeline-marker span { z-index: 1; width: 9px; height: 9px; border: 2px solid #e87338; border-radius: 50%; background: #0a0c0b; box-shadow: 0 0 0 5px rgba(232,115,56,.08); }
	.feed-card { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 28px; padding: 22px; transition: border-color .2s, transform .2s; }
	.feed-card:hover { border-color: rgba(232,115,56,.3); transform: translateY(-2px); }
	.feed-image { position: relative; display: block; height: 190px; overflow: hidden; border-radius: 13px; background: linear-gradient(145deg, #314638, #111513); }
	.feed-image img { width: 100%; height: 100%; object-fit: cover; opacity: .8; filter: saturate(.75); transition: transform .35s, opacity .35s; }
	.feed-image:hover img { opacity: .95; transform: scale(1.035); }
	.feed-image.scroll-preview img { height: auto; min-height: 100%; object-position: top center; transform: translateY(0); transition: transform 5s ease-in-out, opacity .35s, filter .35s; }
	.feed-image.scroll-preview:hover img { opacity: .95; transform: translateY(calc(190px - 100%)); }
	.feed-preview-hint { position: absolute; right: 10px; bottom: 10px; padding: 5px 8px; border: 1px solid rgba(255,255,255,.18); border-radius: 999px; background: rgba(7,9,8,.72); color: #d8dcd6; font-size: 9px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; backdrop-filter: blur(8px); pointer-events: none; transition: opacity .25s, transform .25s; }
	.feed-image:hover .feed-preview-hint { opacity: 0; transform: translateY(4px); }
	.photo-mosaic { display: grid; grid-template-columns: 1.15fr .85fr; grid-template-rows: 94px 94px; gap: 5px; min-height: 190px; overflow: hidden; border-radius: 13px; background: #111513; }
	.work-photo-open { position: relative; min-width: 0; min-height: 0; padding: 0; overflow: hidden; border: 0; background: #111513; color: white; cursor: zoom-in; }
	.work-photo-open:first-child { grid-row: 1 / 3; }
	.work-photo-open:nth-child(4) { display: none; }
	.work-photo-open img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.82); transition: transform .35s, filter .35s; }
	.work-photo-open:hover img { transform: scale(1.04); filter: saturate(1); }
	.work-photo-open span { position: absolute; right: 7px; bottom: 7px; display: grid; width: 27px; height: 27px; place-items: center; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; background: rgba(7,9,8,.62); opacity: 0; transition: opacity .2s; }
	.work-photo-open:hover span, .work-photo-open:focus-visible span { opacity: 1; }
	.feed-types { display: flex; flex-wrap: wrap; gap: 7px; }
	.feed-types span { color: #d88960; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
	.feed-client { margin: 17px 0 5px; color: #777d76; font-size: 12px; letter-spacing: .07em; text-transform: uppercase; }
	.feed-copy h3 { margin: 0; color: #eef0ec; font-size: 27px; font-weight: 500; line-height: 1.15; letter-spacing: -.03em; }
	.feed-excerpt { margin: 10px 0 0; color: #a4aaa2; font-size: 15px; line-height: 1.6; }
	.feed-actions { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 18px; }
	.feed-actions a { display: inline-flex; align-items: center; gap: 6px; color: #c9cdc7; font-size: 12px; font-weight: 700; }
	.feed-actions a:last-child { color: #e88b5c; }
	.view-gallery { display: inline-flex; align-items: center; gap: 6px; padding: 0; border: 0; background: none; color: #e88b5c; font: 700 12px/1.4 Atkinson, sans-serif; cursor: pointer; }
	.work-photo-lightbox { inset: 0; width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(4,5,5,.96); color: white; }
	.work-photo-lightbox::backdrop { background: rgba(4,5,5,.96); backdrop-filter: blur(12px); }
	.work-lightbox-frame { position: relative; display: grid; grid-template-columns: 72px minmax(0,1fr) 72px; align-items: center; width: 100%; height: 100%; padding: 42px 24px 24px; }
	.work-lightbox-content { display: flex; min-width: 0; height: 100%; flex-direction: column; align-items: center; justify-content: center; }
	.work-lightbox-image { display: block; width: auto; max-width: 100%; height: auto; max-height: calc(100dvh - 112px); object-fit: contain; border-radius: 6px; box-shadow: 0 24px 80px rgba(0,0,0,.5); }
	.work-lightbox-meta { display: flex; width: min(100%,1100px); justify-content: space-between; gap: 20px; margin-top: 12px; color: #aeb3ac; font-size: 12px; }
	.work-lightbox-meta p { margin: 0; }
	.work-lightbox-close, .work-lightbox-nav { display: grid; place-items: center; padding: 0; border: 1px solid rgba(255,255,255,.16); border-radius: 50%; background: rgba(255,255,255,.07); color: white; cursor: pointer; }
	.work-lightbox-close { position: absolute; z-index: 2; top: 18px; right: 20px; width: 42px; height: 42px; }
	.work-lightbox-nav { width: 48px; height: 48px; justify-self: center; }
	:global(body:has(.work-photo-lightbox[open])) { overflow: hidden; }
	.empty-feed { margin: 60px 0; color: #8b918a; text-align: center; }
	@media (max-width: 760px) {
		:global(.work-page .page-hero) { padding-top: 48px; padding-bottom: 38px; }
		.work-feed-section { padding: 52px 0 80px; }
		.feed-controls { align-items: start; flex-direction: column; margin-bottom: 38px; }
		.filter-group { justify-items: start; }
		.work-filters { justify-content: flex-start; }
		.timeline::before { left: 8px; }
		.timeline-entry { grid-template-columns: 20px minmax(0, 1fr); }
		.timeline-date { grid-column: 2; padding: 0 0 10px; }
		.timeline-marker { grid-column: 1; grid-row: 1 / span 2; padding-top: 4px; }
		.feed-card { grid-column: 2; grid-template-columns: 1fr; gap: 20px; padding: 18px; }
		.feed-image { height: 210px; }
		.feed-image.scroll-preview:hover img { transform: translateY(calc(210px - 100%)); }
		@media (hover: none) { .feed-image.scroll-preview img { transform: none; } .feed-preview-hint { display: none; } }
		.photo-mosaic { grid-template-rows: 104px 104px; }
		.work-lightbox-frame { grid-template-columns: 52px minmax(0,1fr) 52px; padding-inline: 6px; }
		.work-lightbox-nav { width: 42px; height: 42px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.feed-image.scroll-preview img, .feed-image.scroll-preview:hover img { transform: none; transition: opacity .35s, filter .35s; }
		.feed-preview-hint { display: none; }
	}
</style>

<script>
	const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.work-filters button'));
	const entries = Array.from(document.querySelectorAll<HTMLElement>('.timeline-entry'));
	const emptyFeed = document.querySelector<HTMLElement>('.empty-feed');

	filters.forEach((filter) => {
		filter.addEventListener('click', () => {
			const selected = filter.dataset.filter ?? 'all';
			let visible = 0;
			filters.forEach((button) => {
				const active = button === filter;
				button.classList.toggle('is-active', active);
				button.setAttribute('aria-pressed', String(active));
			});
			entries.forEach((entry) => {
				const types = (entry.dataset.types ?? '').split('|');
				const show = selected === 'all' || types.includes(selected);
				entry.hidden = !show;
				if (show) visible += 1;
			});
			if (emptyFeed) emptyFeed.hidden = visible > 0;
		});
	});

	const workLightbox = document.querySelector<HTMLDialogElement>('.work-photo-lightbox');
	const workPhotoButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.work-photo-open'));
	const workLightboxImage = workLightbox?.querySelector<HTMLImageElement>('.work-lightbox-image');
	const workCaption = workLightbox?.querySelector<HTMLElement>('.work-lightbox-caption');
	const workCount = workLightbox?.querySelector<HTMLElement>('.work-lightbox-count');
	let activeWorkPhoto = 0;
	let activeGallery: HTMLImageElement[] = [];

	function showWorkPhoto(index: number) {
		if (!workLightboxImage || !workCaption || !workCount || activeGallery.length === 0) return;
		activeWorkPhoto = (index + activeGallery.length) % activeGallery.length;
		const source = activeGallery[activeWorkPhoto];
		if (!source) return;
		workLightboxImage.src = source.currentSrc || source.src;
		workLightboxImage.alt = source.alt;
		workCaption.textContent = source.alt;
		workCount.textContent = `${activeWorkPhoto + 1} / ${activeGallery.length}`;
	}

	function openWorkLightbox(galleryId: string, index = 0) {
		const visible = Array.from(document.querySelectorAll<HTMLImageElement>(`.work-photo-open[data-gallery="${galleryId}"] img`));
		const hidden = Array.from(document.querySelectorAll<HTMLImageElement>(`.gallery-source[data-gallery="${galleryId}"]`));
		activeGallery = [...visible, ...hidden];
		showWorkPhoto(index);
		workLightbox?.showModal();
	}
	workPhotoButtons.forEach((button) => button.addEventListener('click', () => openWorkLightbox(button.dataset.gallery ?? '', Number(button.dataset.photoIndex ?? 0))));
	document.querySelectorAll<HTMLButtonElement>('.view-gallery').forEach((button) => button.addEventListener('click', () => openWorkLightbox(button.dataset.gallery ?? '')));
	workLightbox?.querySelector('.work-lightbox-prev')?.addEventListener('click', () => showWorkPhoto(activeWorkPhoto - 1));
	workLightbox?.querySelector('.work-lightbox-next')?.addEventListener('click', () => showWorkPhoto(activeWorkPhoto + 1));
	workLightbox?.querySelector('.work-lightbox-close')?.addEventListener('click', () => workLightbox.close());
	workLightbox?.addEventListener('click', (event) => { if (event.target === workLightbox) workLightbox.close(); });
	workLightbox?.addEventListener('keydown', (event) => {
		if (event.key === 'ArrowLeft') showWorkPhoto(activeWorkPhoto - 1);
		if (event.key === 'ArrowRight') showWorkPhoto(activeWorkPhoto + 1);
	});
</script>
